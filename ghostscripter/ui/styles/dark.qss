/* ============================================================
   GhostScripter-K1-K2 Dark Theme
   Inspired by KotorModTools / GhostRigger color palette
   Dark charcoal IDE aesthetic — VS Code / KotorModTools style
   ============================================================ */

/* ── Global ── */
QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 9pt;
    border: none;
}

QMainWindow {
    background-color: #1e1e1e;
}

/* ── Menu Bar ── */
QMenuBar {
    background-color: #252526;
    color: #cccccc;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px 4px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}
QMenuBar::item:selected {
    background-color: #3c3c3c;
    color: #ffffff;
}
QMenuBar::item:pressed {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    padding: 4px 0px;
}
QMenu::item {
    padding: 5px 24px 5px 16px;
}
QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #3c3c3c;
    margin: 4px 0px;
}

/* ── Toolbar ── */
QToolBar {
    background-color: #252526;
    border-bottom: 1px solid #3c3c3c;
    spacing: 2px;
    padding: 2px 4px;
}
QToolBar::separator {
    width: 1px;
    background: #3c3c3c;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    color: #cccccc;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 9pt;
}
QToolButton:hover {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    color: #ffffff;
}
QToolButton:pressed {
    background-color: #094771;
    border: 1px solid #0078d4;
    color: #ffffff;
}
QToolButton:checked {
    background-color: #0078d4;
    border: 1px solid #1a8fe0;
    color: #ffffff;
}
QToolButton[objectName="primaryAction"] {
    background-color: #0078d4;
    color: #ffffff;
    border: 1px solid #1a8fe0;
    font-weight: bold;
}
QToolButton[objectName="primaryAction"]:hover {
    background-color: #1a8fe0;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    border-top: 1px solid #005fa3;
    font-size: 9pt;
    padding: 0px 6px;
}
QStatusBar::item {
    border: none;
}

/* ── Dock Widgets / Panels ── */
QDockWidget {
    background-color: #252526;
    color: #cccccc;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 5px 8px;
    border-bottom: 1px solid #3c3c3c;
    font-weight: bold;
    font-size: 9pt;
    text-align: left;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #3c3c3c;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #0078d4;
}

/* ── Tabs ── */
QTabWidget::pane {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-top: none;
}
QTabWidget::tab-bar {
    alignment: left;
}
QTabBar {
    background-color: #252526;
}
QTabBar::tab {
    background-color: #2d2d30;
    color: #969696;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    padding: 5px 14px;
    min-width: 60px;
    font-size: 9pt;
}
QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-top: 2px solid #0078d4;
    border-bottom: 1px solid #1e1e1e;
}
QTabBar::tab:hover:!selected {
    background-color: #3c3c3c;
    color: #cccccc;
}
QTabBar::tab:!selected {
    margin-top: 2px;
}

/* ── Group Box ── */
QGroupBox {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #9cdcfe;
    left: 8px;
}

/* ── Scroll Bars ── */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 20px;
    border-radius: 2px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #686868;
}
QScrollBar::handle:vertical:pressed {
    background-color: #0078d4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 12px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 20px;
    border-radius: 2px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #686868;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── List / Tree / Table Widgets ── */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    outline: none;
    alternate-background-color: #2a2a2a;
    gridline-color: #3c3c3c;
    selection-background-color: #094771;
    selection-color: #ffffff;
    show-decoration-selected: 1;
}
QListWidget::item, QTreeWidget::item {
    padding: 3px 4px;
    border: none;
    height: 22px;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #2a2d2e;
    color: #ffffff;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}
QListWidget::item:selected:!active, QTreeWidget::item:selected:!active {
    background-color: #37373d;
    color: #cccccc;
}
QTreeWidget::branch {
    background-color: #252526;
}
QTreeWidget::branch:has-siblings:!adjoins-item {
    border-image: none;
}
QTreeWidget::branch:has-siblings:adjoins-item {
    border-image: none;
}
QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    border-image: none;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(none);
    color: #666666;
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(none);
}

QHeaderView {
    background-color: #252526;
}
QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    padding: 4px 8px;
    font-size: 9pt;
}
QHeaderView::section:hover {
    background-color: #3c3c3c;
}

/* ── Text Inputs ── */
QLineEdit {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px 8px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1px solid #0078d4;
    background-color: #3c3c3c;
}
QLineEdit:hover {
    border: 1px solid #666666;
}
QLineEdit:disabled {
    background-color: #2d2d30;
    color: #666666;
    border-color: #3c3c3c;
}

QTextEdit, QPlainTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
    line-height: 1.4;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0078d4;
}

/* ── Buttons ── */
QPushButton {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 5px 12px;
    min-width: 60px;
    font-size: 9pt;
}
QPushButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #6a6a6a;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #094771;
    border: 1px solid #0078d4;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #2d2d30;
    color: #555555;
    border-color: #3c3c3c;
}
QPushButton[class="primary"] {
    background-color: #0078d4;
    color: #ffffff;
    border: 1px solid #1a8fe0;
    font-weight: bold;
}
QPushButton[class="primary"]:hover {
    background-color: #1a8fe0;
}
QPushButton[class="primary"]:pressed {
    background-color: #005a9e;
}
QPushButton[class="danger"] {
    background-color: #5a1a1a;
    color: #f48771;
    border: 1px solid #7a2a2a;
}
QPushButton[class="danger"]:hover {
    background-color: #7a2a2a;
    color: #ff9999;
}
QPushButton[class="success"] {
    background-color: #1a4a1a;
    color: #4ec9b0;
    border: 1px solid #2a6a2a;
}
QPushButton[class="success"]:hover {
    background-color: #2a6a2a;
}

/* ── Combo Box ── */
QComboBox {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px 8px;
    min-width: 80px;
}
QComboBox:hover {
    border: 1px solid #666666;
}
QComboBox:focus {
    border: 1px solid #0078d4;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #969696;
    width: 0;
    height: 0;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    selection-background-color: #094771;
    selection-color: #ffffff;
    outline: none;
}

/* ── Spin Box ── */
QSpinBox, QDoubleSpinBox {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px 6px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #0078d4;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #3c3c3c;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #4a4a4a;
}

/* ── Check Box / Radio Button ── */
QCheckBox {
    color: #cccccc;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 2px;
    background-color: #3c3c3c;
}
QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}
QCheckBox::indicator:hover {
    border-color: #0078d4;
}
QRadioButton {
    color: #cccccc;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 7px;
    background-color: #3c3c3c;
}
QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

/* ── Sliders ── */
QSlider::groove:horizontal {
    background-color: #3c3c3c;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #0078d4;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    border: 1px solid #1a8fe0;
}
QSlider::handle:horizontal:hover {
    background-color: #1a8fe0;
}
QSlider::sub-page:horizontal {
    background-color: #0078d4;
    border-radius: 2px;
}

/* ── Progress Bar ── */
QProgressBar {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 3px;
    text-align: center;
    height: 16px;
}
QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 2px;
}

/* ── ToolTip ── */
QToolTip {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #555555;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 9pt;
}

/* ── Splitter Handle ── */
QSplitter::handle:hover {
    background-color: #0078d4;
}

/* ── Label ── */
QLabel {
    color: #cccccc;
    background: transparent;
}
QLabel[class="heading"] {
    color: #9cdcfe;
    font-weight: bold;
    font-size: 11pt;
}
QLabel[class="subheading"] {
    color: #4ec9b0;
    font-weight: bold;
}
QLabel[class="error"] {
    color: #f48771;
}
QLabel[class="success"] {
    color: #4ec9b0;
}
QLabel[class="warning"] {
    color: #dcdcaa;
}
QLabel[class="dim"] {
    color: #666666;
    font-size: 8pt;
}
QLabel[class="panel-header"] {
    background-color: #2d2d30;
    color: #cccccc;
    font-weight: bold;
    padding: 5px 8px;
    border-bottom: 1px solid #3c3c3c;
}

/* ── Specific App Panels ── */

/* Project Tree Panel */
QWidget#projectPanel {
    background-color: #252526;
    border-right: 1px solid #3c3c3c;
}
QLabel#projectPanelHeader {
    background-color: #2d2d30;
    color: #cccccc;
    font-weight: bold;
    font-size: 9pt;
    padding: 6px 8px;
    border-bottom: 1px solid #3c3c3c;
}

/* Properties Panel */
QWidget#propertiesPanel {
    background-color: #252526;
    border-left: 1px solid #3c3c3c;
}
QLabel#propertiesPanelHeader {
    background-color: #2d2d30;
    color: #cccccc;
    font-weight: bold;
    padding: 6px 8px;
    border-bottom: 1px solid #3c3c3c;
}

/* Output Console */
QPlainTextEdit#outputConsole {
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
    border: none;
    border-top: 1px solid #3c3c3c;
}
QWidget#outputPanel {
    background-color: #1e1e1e;
    border-top: 1px solid #3c3c3c;
}
QLabel#outputPanelHeader {
    background-color: #2d2d30;
    color: #cccccc;
    font-weight: bold;
    padding: 4px 8px;
    border-bottom: 1px solid #3c3c3c;
    font-size: 9pt;
}

/* Script Editor */
QPlainTextEdit#scriptEditor {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
    border: none;
    selection-background-color: #264f78;
}

/* ── Graph / Canvas View ── */
QGraphicsView {
    background-color: #1a1a1a;
    border: 1px solid #3c3c3c;
}

/* ── Message Box ── */
QMessageBox {
    background-color: #252526;
    color: #cccccc;
}
QMessageBox QPushButton {
    min-width: 70px;
    padding: 5px 14px;
}

/* ── Separator Line ── */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #3c3c3c;
    border: none;
    border-top: 1px solid #3c3c3c;
    max-height: 1px;
}

/* ── Code Number Widget ── */
QWidget#lineNumberArea {
    background-color: #1e1e1e;
    color: #858585;
    border-right: 1px solid #3c3c3c;
}
